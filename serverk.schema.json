								]
							},
							"summary": {
								"type": "object",
								"properties": {
									"ar": {
										"type": "string",
										"minLength": 1,
										"maxLength": 300
									},
									"en": {
										"type": "string",
										"minLength": 1,
										"maxLength": 300
									}
								},
								"required": [
