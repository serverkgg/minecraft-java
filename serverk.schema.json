								]
							},
							"tags": {
								"default": [],
								"maxItems": 8,
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1,
									"maxLength": 32,
									"pattern": "^[a-z0-9][a-z0-9._-]*$"
								}
							},
							"surfaces": {
								"default": [],
								"maxItems": 8,
								"type": "array",
								"items": {
									"type": "string",
									"enum": [
										"overview",
										"console",
										"files",
										"backups",
										"panel"
									]
								}
							},
							"video": {
								"type": "string",
								"pattern": "^[A-Za-z0-9_-]{11}$"
							},
							"bodyPath": {
								"type": "object",
