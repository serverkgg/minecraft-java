					"type": "string",
					"const": "GuidePackage"
				},
				"metadata": {
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"pattern": "^[a-z0-9][a-z0-9-]*$"
						}
					},
					"required": [
